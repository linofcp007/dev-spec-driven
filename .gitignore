# Dependencies — this project has none (zero-dependency by design), but never commit these.
node_modules/
package-lock.json
npm-debug.log*
yarn-error.log*

# OS / editor junk
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.idea/
*.code-workspace

# Logs / temp / coverage
*.log
tmp/
.tmp/
coverage/

# Secrets / local env — never commit your API key
.env
.env.*

# Local Claude Code session/settings (the committed plugin lives in .claude-plugin/)
.claude/

# Dogfooding output: specs generated by running the plugin in THIS repo's root.
# (The worked examples under examples/*/.specs/ are intentionally tracked.)
/.specs/

# Eval harness local artifacts (generated in a user's project, not tracked)
**/evals/baseline.json
**/evals/report.json
