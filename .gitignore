# Dependencies — this project has none (zero-dependency by design), but never commit these.
node_modules/
package-lock.json
npm-debug.log*
yarn-error.log*

# OS / editor junk
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.idea/
*.code-workspace

# Editor workspace dir — ignore everything EXCEPT the committed MCP config.
# .vscode/mcp.json is workspace-relative (${workspaceFolder}) and portable, so it
# stays tracked; personal settings.json/launch.json/tasks.json stay local.
# (Use `.vscode/*`, NOT `.vscode/` — git can't re-include a file whose parent dir
#  is ignored, so the directory must be ignored by its contents for `!` to work.)
.vscode/*
!.vscode/mcp.json

# Logs / temp / coverage
*.log
tmp/
.tmp/
coverage/

# Build/release artifacts (generated by `git archive` for GitHub Releases)
dist/

# Secrets / local env — never commit your API key
.env
.env.*

# Local Claude Code session/settings (the committed plugin lives in .claude-plugin/)
.claude/

# Dogfooding output: specs generated by running the plugin in THIS repo's root.
# (The worked examples under examples/*/.specs/ are intentionally tracked.)
/.specs/

# Eval harness local artifacts (generated in a user's project, not tracked)
**/evals/baseline.json
**/evals/report.json
