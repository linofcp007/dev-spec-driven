{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard-hook.js"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell|Monitor|Write|Edit|NotebookEdit|(mcp__.+__)?(spec_approve|spec_feature|spec_init|spec_add_track)|mcp__.+__(?!spec_|steering_scaffold|ears_validate|trace_check)[\\w-]*?([Ww][Rr][Ii][Tt][Ee]|[Ee][Dd][Ii][Tt]|[Cc][Rr][Ee][Aa][Tt][Ee]|[Mm][Oo][Vv][Ee]|[Rr][Ee][Nn][Aa][Mm][Ee]|[Dd][Ee][Ll][Ee][Tt][Ee]|[Rr][Ee][Mm][Oo][Vv][Ee]|[Cc][Oo][Pp][Yy]|[Aa][Pp][Pp][Ee][Nn][Dd]|[Pp][Aa][Tt][Cc][Hh]|[Rr][Ee][Pp][Ll][Aa][Cc][Ee]|[Ss][Aa][Vv][Ee]|[Pp][Uu][Tt]|[Uu][Pp][Ll][Oo][Aa][Dd]|[Mm][Kk][Dd][Ii][Rr]|[Tt][Oo][Uu][Cc][Hh]|[Tt][Rr][Uu][Nn][Cc][Aa][Tt][Ee]|[Uu][Nn][Ll][Ii][Nn][Kk]|[Ii][Nn][Ss][Ee][Rr][Tt])[\\w-]*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/approval-hook.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/spec-hook.js"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/observe-hook.js"],
            "async": true,
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/plan-hook.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/observe-hook.js"],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/spec-hook.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/stop-hook.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(dev-spec-driven:)?spec-(implementer|simplifier)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/stop-hook.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
