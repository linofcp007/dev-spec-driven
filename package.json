{
  "name": "dev-spec-driven",
  "version": "1.25.1",
  "description": "Unified, track-based spec-driven development: a Claude Code plugin + a local zero-dependency MCP server + a universal CLI that works in any MCP/agent tool (Claude, Cursor, Windsurf, Copilot, Gemini, Codex). No cloud, no CI, no cost.",
  "type": "commonjs",
  "private": true,
  "license": "MIT",
  "author": "Carlos Pereira <carlospereira@prodigitalkey.com>",
  "homepage": "https://github.com/linofcp007/dev-spec-driven#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linofcp007/dev-spec-driven.git"
  },
  "bugs": {
    "url": "https://github.com/linofcp007/dev-spec-driven/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "dev-spec": "cli/dev-spec.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:bundle": "node scripts/build.js --bundle",
    "check": "node scripts/build.js --check",
    "test": "node mcp/test.js && node cli/test-cli.js",
    "test:docker": "node scripts/test-docker.js",
    "mcp": "node mcp/server.js",
    "cli": "node cli/dev-spec.js",
    "evals": "node mcp/evals/run-evals.js"
  },
  "dependencies": {}
}
